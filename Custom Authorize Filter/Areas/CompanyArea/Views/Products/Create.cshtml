@model Product
<!DOCTYPE html>
    <html>
    <head>
        <title></title>
    </head>
    <body>
      <h2> New Product </h2>
      <form method="post" asp-action="Create">
           <div>
               <label asp-for="ProductName"></label>
               <div>
                    <input  asp-for="ProductName" />
               </div>
           </div>

        <div>
            <label asp-for="MfgName"></label>
            <div>
                <input asp-for="MfgName" />
            </div>
        </div>

        <div>
            <label asp-for="Price"></label>
            <div>
                <input asp-for="Price" />
            </div>
        </div>

        
        <div> 
            <input type="submit" value="Save" />
        </div>
      </form>
    </body>
    </html>